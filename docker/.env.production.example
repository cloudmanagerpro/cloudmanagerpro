# =============================================================================
# CloudManagerPro — production environment template
#
#   cp docker/.env.production.example docker/.env.production
#   # then edit the values below (at minimum APP_DOMAIN + the change_me secrets)
#
# Used by:
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build
#
# NEVER commit the real docker/.env.production — only this *.example is tracked.
# Generate strong secrets with:   openssl rand -base64 48
# =============================================================================

# ---- Public domain --------------------------------------------------------
# The domain Caddy serves the app on and obtains a Let's Encrypt certificate for.
# For local testing without a real domain, use `localhost` (internal cert) or
# `:80` (plain HTTP, no TLS).
APP_DOMAIN=cloudmanager.example.com

# ---- PostgreSQL container --------------------------------------------------
POSTGRES_DB=cloudmanagerpro
POSTGRES_USER=cloudmanager
POSTGRES_PASSWORD=change_me_postgres_password

# ---- Backend database connection ------------------------------------------
# DATABASE_URL host must be the compose service name `postgres`.
# DATABASE_USERNAME / DATABASE_PASSWORD MUST match POSTGRES_USER / POSTGRES_PASSWORD.
DATABASE_URL=jdbc:postgresql://postgres:5432/cloudmanagerpro
DATABASE_USERNAME=cloudmanager
DATABASE_PASSWORD=change_me_postgres_password

# ---- Backend security secrets (REQUIRED) ----------------------------------
JWT_SECRET=change_me_use_openssl_rand_base64_48
JWT_EXPIRATION_MS=86400000
ENCRYPTION_SECRET=change_me_use_openssl_rand_base64_48

# ---- URLs -----------------------------------------------------------------
# FRONTEND_URL is used for links and backend CORS; set it to https://APP_DOMAIN.
FRONTEND_URL=https://cloudmanager.example.com
# BACKEND_URL is the internal address of the backend service on the Docker network.
BACKEND_URL=http://backend:8080
# API base path the browser calls (proxied to the backend by Caddy). Leave as /api.
NEXT_PUBLIC_API_URL=/api

# ---- SMTP (optional) — email alerts no-op gracefully if unset -------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=CloudManagerPro <noreply@cloudmanager.example.com>

# ---- Feature flags --------------------------------------------------------
# Demo mode seeds realistic synthetic data on signup so the app is usable with
# zero cloud credentials. Real destructive cloud actions are OFF by default.
ENABLE_DEMO_DATA=true
ENABLE_REAL_CLOUD_ACTIONS=false

# ---- AWS ------------------------------------------------------------------
AWS_DEFAULT_REGION=us-east-1
