# =============================================================================
# CloudManagerPro - frontend (Next.js) local dev environment
# =============================================================================
# Copy this file to `.env.local` and adjust as needed.
#
# NEXT_PUBLIC_API_URL is the base URL for the backend API.
# IMPORTANT: this value ALREADY includes the `/api` prefix. Application code
# must NOT add it again, e.g. fetch(`${NEXT_PUBLIC_API_URL}/auth/login`).
#
# Local development (backend running natively on port 8080):
NEXT_PUBLIC_API_URL=http://localhost:8080/api
#
# Production: the app is served same-origin behind Caddy, so the value becomes:
#   NEXT_PUBLIC_API_URL=/api
