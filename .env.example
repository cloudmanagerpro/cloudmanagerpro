# =============================================================================
# CloudManagerPro - root environment reference (.env.example)
# =============================================================================
# This file is a high-level, at-a-glance pointer to the most common settings.
# It is NOT loaded directly by any service. Use the per-context templates:
#
#   - docker/.env.production.example  -> production template for Docker Compose
#                                        (copy to docker/.env.production and edit)
#   - frontend/.env.example           -> local Next.js frontend dev settings
#   - backend                         -> configured via Spring profiles
#                                        (application{,-local,-docker,-prod}.yml;
#                                        secrets injected as env vars in Docker)
#
# Generate strong secrets, e.g.:  openssl rand -base64 48
# =============================================================================

# Public domain Caddy serves the app on (production).
APP_DOMAIN=cloudmanager.example.com

# Backend security secrets (REQUIRED in production - do not use these defaults).
JWT_SECRET=change-me-please-use-a-long-random-string
ENCRYPTION_SECRET=change-me-please-use-a-long-random-string

# Backend database connection (JDBC URL used by Spring/Flyway).
DATABASE_URL=jdbc:postgresql://postgres:5432/cloudmanagerpro

# Frontend -> backend API base path (proxied to the backend via Caddy).
NEXT_PUBLIC_API_URL=/api

# Feature flags.
ENABLE_DEMO_DATA=true
ENABLE_REAL_CLOUD_ACTIONS=false
